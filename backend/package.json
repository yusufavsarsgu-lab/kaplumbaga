{
  "name": "kaplumbaga-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "build:render": "prisma generate --schema prisma/schema.postgresql.prisma && prisma db push --schema prisma/schema.postgresql.prisma --force-reset --accept-data-loss && prisma db seed && tsc",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "npm run typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:deploy": "prisma db push --schema prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.8.10",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
